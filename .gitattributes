# 防止行尾事故（Windows 开发 / Linux 部署）
* text=auto

# 上传 Linux 的脚本与配置必须 LF
*.sh text eol=lf
*.conf text eol=lf
*.cnf text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
Dockerfile text eol=lf
*.service text eol=lf
*.py text eol=lf

# Windows 批处理必须 CRLF（且内容纯 ASCII）
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制，禁止任何转换
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ttf binary
*.otf binary
*.ttc binary
*.woff2 binary
*.apk binary
*.keystore binary
