# ============================================================
# AI 嵌名赠礼 - 环境变量模板
# 用法：复制本文件为 .env 并填写真实值。.env 已在 .gitignore 中，绝不入库。
# ============================================================

# ---------- 数据库 ----------
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=aipoem
MYSQL_USER=aipoem
MYSQL_PASSWORD=
MYSQL_PORT=3306
MYSQL_HOST=127.0.0.1

# ---------- Redis ----------
REDIS_PORT=6379
REDIS_HOST=127.0.0.1

# ---------- 应用 ----------
APP_ENV=dev
APP_VERSION=0.1.0
JWT_SECRET=
JWT_EXPIRE_DAYS=90
API_PORT=8000

# ---------- 额度 ----------
DAILY_FREE=3
REWARD_PER_VIDEO=3
MAX_AD_PER_DAY=3

# ---------- 大模型（OpenAI 兼容接口）----------
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_MODEL_FAST=

# ---------- 腾讯云 COS ----------
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=
COS_BUCKET=
USE_COS=false

# ---------- 对外地址 ----------
PUBLIC_BASE_URL=https://example.com

# ---------- 广告（默认关闭，先留空）----------
AD_ENABLED=false
AD_SDK=
AD_APP_ID=
AD_SECRET=
